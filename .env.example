# Copy this file to .env. The Docker build excludes all .env files.
# Generate a private endpoint token with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_TRANSPORT=http
MCP_HTTP_TOKEN=
HTTP_PORT=3000
# Optional: public hostname for compose.https.yaml (point its DNS to your server).
# MCP_DOMAIN=images.example.com

# Configure the image provider. These settings are kept on your server.
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://provider.example/v1
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=fast
SKIP_PROMPT_ENHANCEMENT=true

# Enable enhancement only if the same provider supports the Responses API.
# SKIP_PROMPT_ENHANCEMENT=false
# OPENAI_TEXT_MODEL=your-text-model-id

# Other adapters are also available:
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# GEMINI_IMAGE_MODEL=
# GEMINI_TEXT_MODEL=
# IMAGE_PROVIDER=seedream
# ARK_API_KEY=
# ARK_BASE_URL=
# SEEDREAM_IMAGE_MODEL=
# SEEDREAM_TEXT_MODEL=
